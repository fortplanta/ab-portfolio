---
import type { Section } from "@/lib/content/types";
import HeroSection from "@/components/sections/HeroSection.astro";
import ImageSection from "@/components/sections/ImageSection.astro";
import VideoSection from "@/components/sections/VideoSection.astro";
import TextSection from "@/components/sections/TextSection.astro";
import ImageGridSection from "@/components/sections/ImageGridSection.astro";

interface Props {
  section: Section;
  isFirstHero: boolean;
}

const { section, isFirstHero } = Astro.props;
---

<div
  id={section.id}
  data-section-id={section.id}
  data-nav-contrast={section.navContrast}
  class:list={[
    "section-block relative w-full overflow-hidden",
    section.isFullScreen
      ? "flex min-h-[100vh] min-h-[100dvh] items-center justify-center"
      : "px-6 py-20 md:px-12 md:py-28",
  ]}
>
  {section.type === "hero" && <HeroSection section={section} isFirstHero={isFirstHero} />}
  {section.type === "image" && <ImageSection section={section} />}
  {section.type === "video" && <VideoSection section={section} />}
  {section.type === "text" && <TextSection section={section} />}
  {section.type === "image-grid" && <ImageGridSection section={section} />}
</div>
