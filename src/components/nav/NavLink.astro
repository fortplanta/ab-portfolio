---
interface Props {
  slug: string;
  label: string;
}

const { slug, label } = Astro.props;
---

<a
  href={`#${slug}`}
  data-nav-link
  data-slug={slug}
  class="nav-link inline-flex shrink-0 items-center rounded-full border border-white/10 px-3 py-2 text-sm font-medium backdrop-blur-sm md:py-1.5"
>
  {label}
</a>
