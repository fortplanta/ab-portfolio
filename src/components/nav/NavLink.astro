---
interface Props {
  slug: string;
  label: string;
}

const { slug, label } = Astro.props;
---

<a
  href={`#${slug}`}
  data-nav-link
  data-slug={slug}
  class="nav-link inline-flex shrink-0 items-center rounded-full border border-white/10 bg-background/70 px-3 py-1.5 text-sm font-medium text-foreground/70 backdrop-blur-sm transition-colors duration-200 ease-out hover:text-foreground aria-[current=true]:bg-foreground aria-[current=true]:text-background"
>
  {label}
</a>
