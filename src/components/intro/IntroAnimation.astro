---
// One-shot preloader: plays on every page load, removes itself when done.
---

<div id="intro-overlay" aria-hidden="true">
  <section class="intro">
    <div class="intro__images">
      <img src="/intro/photo2.jpg" alt="" />
      <img src="/intro/photo3.jpg" alt="" />
      <img src="/intro/photo4.jpg" alt="" />
      <img src="/intro/photo5.jpg" alt="" />
      <img src="/intro/photo6.jpg" alt="" />
      <img src="/intro/photo7.jpg" alt="" />
      <img src="/intro/photo8.jpg" alt="" />
    </div>

    <div class="intro__center-image" data-hidden>
      <img src="/intro/photo_main.jpg" alt="" />
    </div>

    <div class="intro__text">
      <h1 class="intro__title">
        <span data-animation="text-reveal"><span>it's</span></span>
        <span data-animation="text-reveal"><span>in the</span></span>
        <span data-animation="text-reveal"><span>Details</span></span>
      </h1>
    </div>
  </section>
</div>

<style is:global>
  #intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #0c0c0c;
    overflow: hidden;
  }

  #intro-overlay .intro {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  #intro-overlay .intro img {
    position: absolute;
    object-fit: cover;
  }

  #intro-overlay .intro__images img:nth-child(3),
  #intro-overlay .intro__images img:nth-child(2),
  #intro-overlay .intro__images img:nth-child(5),
  #intro-overlay .intro__images img:nth-child(6) {
    width: 12.5vw;
    height: 25.7vh;
  }

  #intro-overlay .intro__images img:nth-child(7),
  #intro-overlay .intro__images img:nth-child(4),
  #intro-overlay .intro__images img:nth-child(1),
  #intro-overlay .intro__images img:nth-child(8) {
    width: 16.7vw;
    height: 20.6vh;
  }

  /* Default (FLIP target): all images centered, xPercent/yPercent applied by JS */
  #intro-overlay .intro__images img {
    top: 50%;
    left: 50%;
    transform-origin: center center;
  }

  /* Initial scattered positions — CSS class applied before GSAP reads the flip state */
  #intro-overlay .intro__images.initial img:nth-child(1) {
    top: 59.9vh;
    left: 75.3vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(2) {
    top: 43.2vh;
    left: 26.3vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(3) {
    top: 25.1vh;
    left: 55.7vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(4) {
    top: 16.4vh;
    left: 76.3vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(5) {
    top: 61.7vh;
    left: 49vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(6) {
    top: 20.1vh;
    left: 11vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(7) {
    top: 69.6vh;
    left: 6.8vw;
  }

  #intro-overlay .intro__center-image {
    width: 100%;
    height: 100vh;
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    overflow: hidden;
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  #intro-overlay .intro__center-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    filter: brightness(0.9);
  }

  #intro-overlay .intro__center-image.initial {
    top: 15%;
    left: 40%;
  }

  #intro-overlay .intro__text {
    position: absolute;
    bottom: 2rem;
    left: 0;
    z-index: 3;
  }

  #intro-overlay .intro__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #f0ede8;
    padding: 0 3.2rem;
    line-height: 1;
  }

  #intro-overlay [data-animation='text-reveal'] {
    display: block;
    overflow: hidden;
  }

  #intro-overlay [data-animation='text-reveal'] > * {
    display: block;
    line-height: 1;
    transform: translateY(100%);
  }

  #intro-overlay [data-hidden] {
    opacity: 0;
  }

  body.is-loading {
    overflow-y: hidden;
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { Flip } from 'gsap/Flip'

  gsap.registerPlugin(Flip)

  const overlay = document.getElementById('intro-overlay')!
  const centerImageWrapper = overlay.querySelector<HTMLElement>('.intro__center-image')!
  const centerImage = centerImageWrapper.querySelector<HTMLElement>('img')!
  const imagesWrapper = overlay.querySelector<HTMLElement>('.intro__images')!
  const images = [...imagesWrapper.querySelectorAll<HTMLElement>('img')]
  const titleLines = '#intro-overlay h1 [data-animation="text-reveal"] > *'
  const body = document.body

  // 1. Read the FLIP end-state (images centred, translated -50%/-50%) before scattering.
  gsap.set([...images, centerImageWrapper], { xPercent: -50, yPercent: -50 })
  const flipState = Flip.getState([centerImageWrapper, ...images])

  // 2. Apply scattered initial positions via CSS class + GSAP overrides.
  centerImageWrapper.classList.add('initial')
  imagesWrapper.classList.add('initial')
  body.classList.add('is-loading')

  gsap.set(images, { xPercent: 0, yPercent: 0, y: 80 })
  gsap.set(centerImageWrapper, { y: 80, scale: 0.15 })
  gsap.set(centerImage, { scale: 1.5 })

  // 3. Fade all images up from below.
  gsap.to([...images, centerImageWrapper], {
    y: 0,
    opacity: 1,
    duration: 3,
    ease: 'power3.inOut',
    stagger: 0.1,
    onComplete: moveToCenter,
  })

  function moveToCenter() {
    Flip.to(flipState, {
      duration: 2,
      ease: 'expo.inOut',
      stagger: 0.15,
      onComplete: scaleCenterImage,
    })
  }

  function scaleCenterImage() {
    gsap
      .timeline({ onComplete: revealContent })
      .to(centerImageWrapper, { scale: 1, duration: 2, ease: 'expo.inOut' })
      .to(centerImage, { scale: 1, duration: 2, ease: 'expo.inOut' }, 0)
  }

  function revealContent() {
    gsap
      .timeline({
        defaults: { y: 0, duration: 2, ease: 'expo.out' },
        onComplete: finish,
      })
      .to(titleLines, { stagger: 0.2 })
  }

  function finish() {
    body.classList.remove('is-loading')
    gsap.to(overlay, {
      opacity: 0,
      duration: 0.8,
      ease: 'power2.inOut',
      onComplete: () => overlay.remove(),
    })
  }
</script>
