---
import type { IntroPoolItem } from '@/lib/content/intro-pool'

interface Props {
  heroSrc: string
  heroAlt?: string
  title: string
  client?: string
  highlights?: string[]
  pool?: IntroPoolItem[]
}

const { heroSrc, heroAlt = '', title, client, highlights = [], pool = [] } = Astro.props
const showClient = client && client.trim().toLowerCase() !== title.trim().toLowerCase()
---

<div id="intro-overlay" aria-hidden="true">
  <script type="application/json" id="intro-pool" is:inline set:html={JSON.stringify(pool)} />
  <section class="intro">
    <div class="intro__images"></div>

    <div class="intro__center-image" data-hidden>
      <img src={heroSrc} alt={heroAlt} />
    </div>

    <div class="hero-caption">
      <div>
        {showClient && (
          <p class="hero-caption__client">
            <span data-animation="text-reveal"><span>{client}</span></span>
          </p>
        )}
        <h2 class="hero-caption__title">
          <span data-animation="text-reveal"><span>{title}</span></span>
        </h2>
      </div>
      {highlights.length > 0 && (
        <ul class="hero-caption__highlights">
          {highlights.map((line) => (
            <li><span data-animation="text-reveal"><span>{line}</span></span></li>
          ))}
        </ul>
      )}
    </div>
  </section>
</div>

<style is:global>
  #intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #0c0c0c;
    overflow: hidden;
  }

  #intro-overlay .intro {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  #intro-overlay .intro img {
    position: absolute;
    object-fit: cover;
  }

  #intro-overlay .intro__images img:nth-child(3),
  #intro-overlay .intro__images img:nth-child(2),
  #intro-overlay .intro__images img:nth-child(5),
  #intro-overlay .intro__images img:nth-child(6) {
    width: 12.5vw;
    height: 25.7vh;
  }

  #intro-overlay .intro__images img:nth-child(7),
  #intro-overlay .intro__images img:nth-child(4),
  #intro-overlay .intro__images img:nth-child(1),
  #intro-overlay .intro__images img:nth-child(8) {
    width: 16.7vw;
    height: 20.6vh;
  }

  /* Default (FLIP target): all images centered */
  #intro-overlay .intro__images img {
    top: 50%;
    left: 50%;
    transform-origin: center center;
  }

  /* Initial scattered positions */
  #intro-overlay .intro__images.initial img:nth-child(1) {
    top: 59.9vh;
    left: 75.3vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(2) {
    top: 43.2vh;
    left: 26.3vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(3) {
    top: 25.1vh;
    left: 55.7vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(4) {
    top: 16.4vh;
    left: 76.3vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(5) {
    top: 61.7vh;
    left: 49vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(6) {
    top: 20.1vh;
    left: 11vw;
  }
  #intro-overlay .intro__images.initial img:nth-child(7) {
    top: 69.6vh;
    left: 6.8vw;
  }

  #intro-overlay .intro__center-image {
    width: 100%;
    height: 100vh;
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    overflow: hidden;
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  #intro-overlay .intro__center-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    filter: brightness(0.9);
  }

  #intro-overlay .intro__center-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.4), transparent 45%);
  }

  #intro-overlay .hero-caption::before {
    display: none;
  }

  #intro-overlay .intro__center-image.initial {
    top: 15%;
    left: 40%;
  }

  #intro-overlay [data-animation='text-reveal'] {
    display: block;
    overflow: hidden;
    padding-bottom: 0.15em;
    margin-bottom: -0.15em;
  }

  #intro-overlay [data-animation='text-reveal'] > * {
    display: block;
    transform: translateY(100%);
  }

  #intro-overlay [data-hidden] {
    opacity: 0;
  }

  body.is-loading {
    overflow-y: hidden;
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { Flip } from 'gsap/Flip'

  gsap.registerPlugin(Flip)

  const overlay = document.getElementById('intro-overlay')!
  const centerImageWrapper = overlay.querySelector<HTMLElement>('.intro__center-image')!
  const centerImage = centerImageWrapper.querySelector<HTMLElement>('img')!
  const imagesWrapper = overlay.querySelector<HTMLElement>('.intro__images')!

  interface PoolItem {
    src: string
    alt: string
    group: string
    multi: boolean
  }

  const shuffle = <T,>(items: T[]) => {
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[items[i], items[j]] = [items[j], items[i]]
    }
    return items
  }

  // Prefer one random image per project (collection projects like Misc are fine to
  // repeat); if that leaves too few for a full collage, top up with any remaining
  // images. Never the same image twice.
  function pickIntroImages(pool: PoolItem[], max: number): PoolItem[] {
    const byProject = new Map<string, PoolItem[]>()
    const collection: PoolItem[] = []
    for (const item of pool) {
      if (item.multi) {
        collection.push(item)
      } else {
        byProject.set(item.group, [...(byProject.get(item.group) ?? []), item])
      }
    }
    const singles = shuffle(
      [...byProject.values()].map((items) => items[Math.floor(Math.random() * items.length)]),
    ).slice(0, max)
    const picked = [...singles, ...shuffle(collection).slice(0, max - singles.length)]
    const rest = shuffle(pool.filter((item) => !picked.includes(item)))
    return [...picked, ...rest.slice(0, max - picked.length)]
  }

  const LOAD_TIMEOUT_MS = 8000

  // Resolves true once the image is fully fetched and decoded; false on error or timeout.
  function loadImage(src: string): Promise<HTMLImageElement | null> {
    return new Promise((resolve) => {
      const img = new Image()
      const timer = window.setTimeout(() => resolve(null), LOAD_TIMEOUT_MS)
      img.alt = ''
      img.decoding = 'async'
      img.src = src
      img.decode().then(
        () => {
          window.clearTimeout(timer)
          resolve(img)
        },
        () => {
          window.clearTimeout(timer)
          resolve(null)
        },
      )
    })
  }

  // Each scattered image gets the same visual area as its CSS slot but keeps its own
  // aspect ratio, so nothing is cropped by object-fit: cover.
  const PORTRAIT_SLOTS = [2, 3, 5, 6] // 1-based child indexes, mirrors the CSS
  function fitToSlot(img: HTMLImageElement, index: number) {
    const vw = window.innerWidth / 100
    const vh = window.innerHeight / 100
    const [slotW, slotH] = PORTRAIT_SLOTS.includes(index + 1) ? [12.5, 25.7] : [16.7, 20.6]
    const area = slotW * vw * slotH * vh
    const ratio = img.naturalWidth / img.naturalHeight || 1
    let width = Math.sqrt(area * ratio)
    let height = width / ratio
    const scale = Math.min(1, (vw * 24) / width, (vh * 34) / height)
    width *= scale
    height *= scale
    img.style.width = `${width}px`
    img.style.height = `${height}px`
  }

  let pool: PoolItem[] = []
  try {
    pool = JSON.parse(document.getElementById('intro-pool')?.textContent ?? '[]')
  } catch {}

  const textLines = '#intro-overlay [data-animation="text-reveal"] > *'
  const body = document.body

  // Keep the page locked behind the dark overlay while assets load.
  body.classList.add('is-loading')

  async function init() {
    const picked = shuffle(pickIntroImages(pool, 7))
    const centerSrc = (centerImage as HTMLImageElement).currentSrc || (centerImage as HTMLImageElement).src

    // Wait for the centre image and every scattered image to be fully loaded,
    // so nothing pops in or paints half-decoded once the animation starts.
    const [, ...loaded] = await Promise.all([
      loadImage(centerSrc),
      ...picked.map((item) => loadImage(item.src)),
    ])
    const images = loaded.filter((img): img is HTMLImageElement => img !== null)
    images.forEach((img, i) => {
      fitToSlot(img, i)
      imagesWrapper.appendChild(img)
    })

    start(images)
  }

  function start(images: HTMLImageElement[]) {
    // 1. Read the FLIP end-state before scattering.
    gsap.set([...images, centerImageWrapper], { xPercent: -50, yPercent: -50 })
    const flipState = Flip.getState([centerImageWrapper, ...images])

    // 2. Apply scattered initial positions via CSS class + GSAP overrides.
    centerImageWrapper.classList.add('initial')
    imagesWrapper.classList.add('initial')

    gsap.set(images, { xPercent: 0, yPercent: 0, y: 80 })
    gsap.set(centerImageWrapper, { y: 80, scale: 0.15 })
    gsap.set(centerImage, { scale: 1.5 })

    // 3. Fade all images up from below.
    gsap.to([...images, centerImageWrapper], {
      y: 0,
      opacity: 1,
      duration: 3,
      ease: 'power3.inOut',
      stagger: 0.1,
      onComplete: () => moveToCenter(flipState),
    })
  }

  function moveToCenter(flipState: ReturnType<typeof Flip.getState>) {
    Flip.to(flipState, {
      duration: 2,
      ease: 'expo.inOut',
      stagger: 0.15,
      onComplete: scaleCenterImage,
    })
  }

  function scaleCenterImage() {
    gsap
      .timeline({ onComplete: revealContent })
      .to(centerImageWrapper, { scale: 1, duration: 2, ease: 'expo.inOut' })
      .to(centerImage, { scale: 1, duration: 2, ease: 'expo.inOut' }, 0)
  }

  function revealContent() {
    gsap
      .timeline({
        defaults: { y: 0, duration: 1.6, ease: 'expo.out' },
        onComplete: finish,
      })
      .to(textLines, { stagger: 0.08 })
  }

  function finish() {
    try { sessionStorage.setItem('intro-played-v1', '1') } catch {}
    body.classList.remove('is-loading')
    gsap.to(overlay, {
      opacity: 0,
      duration: 0.8,
      ease: 'power2.inOut',
      onComplete: () => overlay.remove(),
    })
  }

  init()
</script>
