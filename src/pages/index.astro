---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/nav/SiteNav.astro";
import ProjectSection from "@/components/project/ProjectSection.astro";
import { getAdapter } from "@/lib/content/adapter";

const adapter = getAdapter();
const projects = await adapter.getProjects();
---

<BaseLayout
  title="Portfolio"
  description="Selected client work — identity, web, campaign, and photography projects."
>
  <SiteNav projects={projects} />
  <main>
    {
      projects.map((project, index) => (
        <ProjectSection project={project} isFirstProject={index === 0} />
      ))
    }
  </main>
</BaseLayout>
