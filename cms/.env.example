# A long random string used to sign JWTs and cookies.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-here

# SQLite database file path (relative to cms/).
# For production, switch to @payloadcms/db-postgres and set a postgres:// URL.
DATABASE_URI=file:./cms.db

# Public URL of this CMS instance (no trailing slash).
# Used for media asset URLs and CORS.
PAYLOAD_URL=http://localhost:3001

# URL of the Astro front-end (added to CORS allowlist).
ASTRO_SITE_URL=http://localhost:4321
