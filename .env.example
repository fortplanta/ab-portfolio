# Content source. "fixture" (default) renders the local fixture projects in
# src/content/fixtures/ — no backend required. Set to "payload" once a real
# Payload CMS instance exists.
CONTENT_SOURCE=fixture

# Required when CONTENT_SOURCE=payload. Base URL of the Payload instance,
# no trailing slash (e.g. https://cms.example.com).
PAYLOAD_API_URL=
